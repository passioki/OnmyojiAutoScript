+                OutlinedButton(
+                  onPressed: c.selected.isEmpty || c.busy
+                      ? null
+                      : () => c.bulkApply(false),
+                  child: const Text('停用选中'),
+                ),
+                const SizedBox(width: 8),
+                SizedBox(
