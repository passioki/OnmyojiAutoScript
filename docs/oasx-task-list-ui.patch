diff --git a/lib/views/tasks/run_control_bar.dart b/lib/views/tasks/run_control_bar.dart
new file mode 100644
index 0000000..af8083d
--- /dev/null
+++ b/lib/views/tasks/run_control_bar.dart
@@ -0,0 +1,219 @@
+part of task_list;
+
+/// 顶部运行控制条:暂停 / 继续 / **全部停止** / **只停列表**。
+///
+/// ## 三种运行控件的语义（用户已确认, 不可混用）
+///
+/// | 控件 | `mode` | 行为 |
+/// |---|---|---|
+/// | ⏸ 暂停调度 | `battle` | 跑完**当前这场战斗**(安全点)后不再开新任务 |
+/// | ⏭ 本轮跑完再停 | `round` | 本任务本轮**打满目标次数**再停 |
+/// | ▶ 继续调度 | `resume` | 恢复 |
+///
+/// ★ **不提供「立即停」** —— 会卡在半途(战斗中/组队房间中), 不安全。
+///
+/// ## 效果命名（用户明确要求）
+///
+/// 不说"休息 / 延后"(那两个词都容易误解), 而按**效果**命名:
+///
+/// | 按钮 | 效果 | 对定时任务 |
+/// |---|---|---|
+/// | **全部停止** | 暂停调度 N 分钟 | ✅ 一起停 |
+/// | **只停列表** | 只推迟列表 N 分钟 | ❌ 照常 |
+///
+/// ★ 名字里就写着**唯一区别**。
+///
+/// ## 与「执行顺序」面板里的控制条目是什么关系
+///
+/// | | 这里的按钮 | 列表里的条目 |
+/// |---|---|---|
+/// | 生效时机 | **现在** | **执行到那一行时** |
+/// | 位置 | 全局 | 可插到任意位置 |
+///
+/// 两者调用**同一套** `run_control` 状态, 所以不会冲突。
+class RunControlBar extends StatefulWidget {
+  const RunControlBar({super.key, required this.controller});
+
+  final TaskListController controller;
+
+  @override
+  State<RunControlBar> createState() => _RunControlBarState();
+}
+
+class _RunControlBarState extends State<RunControlBar> {
+  Map<String, dynamic> _state = {};
+  bool _busy = false;
+
+  /// 显式传入 —— 不靠 `Get.find` + 路由参数, 嵌套时更可靠。
+  TaskListController get _c => widget.controller;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    final s = await ApiClient().getRunControl(_c.script);
+    if (!mounted) return;
+    setState(() => _state = s);
+  }
+
+  Future<void> _do(Future<bool> Function() fn) async {
+    setState(() => _busy = true);
+    try {
+      await fn();
+      await _load();
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  /// 效果名 —— 优先用 `/schema` 给的名字(后端改名前端自动跟上)。
+  String _label(String kind, String fallback) {
+    for (final k in _c.entryKinds) {
+      if ('${k['value']}' == kind) return '${k['label']}';
+    }
+    return fallback;
+  }
+
+  String _help(String kind, String fallback) {
+    for (final k in _c.entryKinds) {
+      if ('${k['value']}' == kind) return '${k['help']}';
+    }
+    return fallback;
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final paused = _state['paused'] == true;
+    final restUntil = _state['rest_until'];
+    final listResumeAt = _state['list_resume_at'];
+    final pauseLabel = '${_state['pause_mode_label'] ?? '运行中'}';
+
+    return Card(
+      margin: const EdgeInsets.fromLTRB(12, 8, 12, 4),
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+        child: Wrap(
+          spacing: 8,
+          runSpacing: 4,
+          crossAxisAlignment: WrapCrossAlignment.center,
+          children: [
+            // ---- 当前状态 ----
+            Container(
+              width: 10,
+              height: 10,
+              decoration: BoxDecoration(
+                color: paused ? Colors.orange : Colors.green,
+                shape: BoxShape.circle,
+              ),
+            ),
+            const SizedBox(width: 4),
+            Text(pauseLabel),
+            if (restUntil != null)
+              Chip(
+                label: Text('${_label('rest', '全部停止')} 至 $restUntil'),
+                visualDensity: VisualDensity.compact,
+              ),
+            if (listResumeAt != null)
+              Chip(
+                label: Text('${_label('delay', '只停列表')} 至 $listResumeAt'),
+                visualDensity: VisualDensity.compact,
+              ),
+            const SizedBox(width: 12),
+
+            // ---- 三个运行控件 ----
+            if (!paused) ...[
+              Tooltip(
+                message: '跑完当前这场战斗后不再开新任务',
+                child: FilledButton.icon(
+                  onPressed: _busy
+                      ? null
+                      : () => _do(() => ApiClient()
+                          .pauseScript(_c.script, mode: 'battle')),
+                  icon: const Icon(Icons.pause, size: 18),
+                  label: const Text('暂停调度'),
+                ),
+              ),
+              Tooltip(
+                message: '本任务本轮打满目标次数后再停',
+                child: OutlinedButton.icon(
+                  onPressed: _busy
+                      ? null
+                      : () => _do(() =>
+                          ApiClient().pauseScript(_c.script, mode: 'round')),
+                  icon: const Icon(Icons.skip_next, size: 18),
+                  label: const Text('本轮跑完再停'),
+                ),
+              ),
+            ],
+            if (paused)
+              FilledButton.icon(
+                onPressed: _busy
+                    ? null
+                    : () => _do(() => ApiClient().resumeScript(_c.script)),
+                icon: const Icon(Icons.play_arrow, size: 18),
+                label: const Text('继续调度'),
+              ),
+
+            const SizedBox(width: 12),
+
+            // ---- 效果命名的两个时长控制 ----
+            Tooltip(
+              message: _help('rest', '暂停调度 N 分钟 —— 连定时任务一起停'),
+              child: OutlinedButton.icon(
+                onPressed: _busy
+                    ? null
+                    : () => _pickMinutes('rest', _label('rest', '全部停止')),
+                icon: const Icon(Icons.stop_circle_outlined, size: 18),
+                label: Text(_label('rest', '全部停止')),
+              ),
+            ),
+            Tooltip(
+              message: _help('delay', '只推迟列表 N 分钟 —— 定时任务照常'),
+              child: OutlinedButton.icon(
+                onPressed: _busy
+                    ? null
+                    : () => _pickMinutes('delay', _label('delay', '只停列表')),
+                icon: const Icon(Icons.schedule, size: 18),
+                label: Text(_label('delay', '只停列表')),
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Future<void> _pickMinutes(String kind, String label) async {
+    final choices = _c.durationChoices;
+    final minutes = await showDialog<int>(
+      context: context,
+      builder: (ctx) => SimpleDialog(
+        title: Text(label),
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(24, 0, 24, 12),
+            child: Text(_help(kind, ''),
+                style: Theme.of(ctx).textTheme.labelMedium),
+          ),
+          for (final m in choices)
+            SimpleDialogOption(
+              onPressed: () => Navigator.pop(ctx, m),
+              child: Text(m >= 60 && m % 60 == 0 ? '${m ~/ 60} 小时' : '$m 分钟'),
+            ),
+          const Divider(),
+          SimpleDialogOption(
+            onPressed: () => Navigator.pop(ctx, 0),
+            child: const Text('取消'),
+          ),
+        ],
+      ),
+    );
+    if (minutes == null) return;
+    await _do(() => kind == 'rest'
+        ? ApiClient().restScript(_c.script, minutes)
+        : ApiClient().delayScript(_c.script, minutes));
+  }
+}
diff --git a/lib/views/tasks/run_list_panel.dart b/lib/views/tasks/run_list_panel.dart
new file mode 100644
index 0000000..b0520f0
--- /dev/null
+++ b/lib/views/tasks/run_list_panel.dart
@@ -0,0 +1,272 @@
+part of task_list;
+
+/// 「执行顺序」面板 —— **模型 B 的核心界面**。
+///
+/// ## 与"只是任务顺序"的区别
+///
+/// 列表是**有序条目**的序列, 里面可以混入控制条目:
+///
+///     1. 探索
+///     2. 御魂
+///     3. [全部停止 30 分钟]     ← 一条"条目", 不是按钮
+///     4. 金币妖怪
+///
+/// ★ 所以控制条目能**插到任意位置** —— 这正是原型说的
+///   "都可插入到任意位置", 也是本模型存在的理由。
+///
+/// ## 条目类型不硬编码
+///
+/// 效果名(全部停止 / 只停列表)、说明、以及"需不需要时长"这些标志
+/// 全部从 `/schema` 的 `list.entry_kinds` 读 ——
+/// 后端改名前端自动跟上, 不会两处不一致。
+///
+/// ## 视觉上必须让用户看出"哪一条会停"
+///
+/// `task` 条目不阻塞(未就绪就跳过), `rest`/`delay` 阻塞列表 ——
+/// 这是**语义差别**, 界面必须体现(用不同图标与底色),
+/// 否则用户会以为"为什么列表卡在这里不动"。
+class RunListPanel extends StatelessWidget {
+  const RunListPanel({super.key, required this.c});
+
+  final TaskListController c;
+
+  @override
+  Widget build(BuildContext context) {
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            _title(context),
+            const SizedBox(height: 4),
+            Text(
+              '拖动 ⠿ 调整顺序 · 序号即优先级 · '
+              '「${c.kindOf("rest")["label"]}」会停在那一行',
+              style: Theme.of(context).textTheme.labelSmall,
+            ),
+            const SizedBox(height: 8),
+            if (c.entries.isEmpty)
+              _empty(context)
+            else
+              ReorderableListView.builder(
+                shrinkWrap: true,
+                physics: const NeverScrollableScrollPhysics(),
+                buildDefaultDragHandles: false,
+                itemCount: c.entries.length,
+                onReorder: c.reorderEntries,
+                itemBuilder: (_, i) => _entryRow(context, i),
+              ),
+            const SizedBox(height: 12),
+            _actions(context),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _title(BuildContext context) {
+    return Text('执行顺序', style: Theme.of(context).textTheme.titleSmall);
+  }
+
+  Widget _empty(BuildContext context) {
+    return Container(
+      width: double.infinity,
+      padding: const EdgeInsets.symmetric(vertical: 20),
+      child: Column(
+        children: [
+          Text('（未编排 —— 正在用内置默认顺序）',
+              style: Theme.of(context).textTheme.labelMedium),
+          const SizedBox(height: 4),
+          Text('添加条目即可自定义执行顺序',
+              style: Theme.of(context).textTheme.labelSmall),
+        ],
+      ),
+    );
+  }
+
+  Widget _entryRow(BuildContext context, int i) {
+    final e = c.entries[i];
+    final isTask = c.isTaskEntry(e);
+    // ★ 阻塞条目给不同底色 —— 用户一眼看出"这里会停"
+    final bg = isTask
+        ? null
+        : Theme.of(context).colorScheme.errorContainer.withValues(alpha: 0.35);
+
+    return Container(
+      key: ValueKey('entry-$i-${e['kind']}-${e['task'] ?? e['minutes']}'),
+      color: bg,
+      child: Padding(
+        padding: const EdgeInsets.symmetric(vertical: 4),
+        child: Row(
+          children: [
+            ReorderableDragStartListener(
+              index: i,
+              child: const Padding(
+                padding: EdgeInsets.symmetric(horizontal: 6),
+                child: Icon(Icons.drag_handle, size: 20),
+              ),
+            ),
+            SizedBox(
+              width: 28,
+              child: Text('${i + 1}',
+                  style: Theme.of(context).textTheme.labelMedium),
+            ),
+            Icon(isTask ? Icons.play_circle_outline : Icons.pause_circle_outline,
+                size: 18,
+                color: isTask ? null : Theme.of(context).colorScheme.error),
+            const SizedBox(width: 8),
+            Expanded(
+              child: Text(c.describeEntry(e),
+                  style: Theme.of(context).textTheme.bodyMedium),
+            ),
+            // 类型标签也来自 schema, 不硬编码
+            Chip(
+              label: Text('${c.kindOf('${e['kind']}')['label']}'),
+              visualDensity: VisualDensity.compact,
+              labelStyle: Theme.of(context).textTheme.labelSmall,
+            ),
+            IconButton(
+              tooltip: '删除此条目',
+              icon: const Icon(Icons.close, size: 18),
+              onPressed: () => c.removeEntry(i),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Widget _actions(BuildContext context) {
+    return Wrap(
+      spacing: 8,
+      runSpacing: 4,
+      children: [
+        FilledButton.icon(
+          onPressed: () => _pickTask(context),
+          icon: const Icon(Icons.add, size: 18),
+          label: const Text('添加任务'),
+        ),
+        // ★ 为**每一种非 task 条目**各生成一个按钮 —— 不硬编码"休息/延后"
+        for (final k in c.entryKinds)
+          if (k['needs_minutes'] == true)
+            OutlinedButton.icon(
+              onPressed: () => _addControlEntry(context, k),
+              icon: const Icon(Icons.pause_circle_outline, size: 18),
+              label: Text('添加「${k['label']}」'),
+            ),
+        TextButton(
+          onPressed: c.entries.isEmpty ? null : c.resetToDefault,
+          child: const Text('恢复默认'),
+        ),
+      ],
+    );
+  }
+
+  /// 选一个任务加进列表。
+  Future<void> _pickTask(BuildContext context) async {
+    final picked = await showDialog<String>(
+      context: context,
+      builder: (ctx) => _TaskPickerDialog(controller: c),
+    );
+    if (picked == null) return;
+    await c.addEntry({'kind': 'task', 'task': picked});
+  }
+
+  /// 添加一个控制条目(`rest` / `delay`)。
+  ///
+  /// ★ 时长可选项来自 `/schema` 的 `duration_choices`。
+  /// ★ 说明文字来自 `/schema` 的 `entry_kinds[].help` ——
+  ///   里面写着**对定时任务的不同处理**, 这是用户唯一需要知道的区别。
+  Future<void> _addControlEntry(
+      BuildContext context, Map<String, dynamic> kind) async {
+    final minutes = await showDialog<int>(
+      context: context,
+      builder: (ctx) => SimpleDialog(
+        title: Text('添加「${kind['label']}」'),
+        children: [
+          Padding(
+            padding: const EdgeInsets.fromLTRB(24, 0, 24, 12),
+            child: Text('${kind['help']}',
+                style: Theme.of(ctx).textTheme.labelMedium),
+          ),
+          for (final m in c.durationChoices)
+            SimpleDialogOption(
+              onPressed: () => Navigator.pop(ctx, m),
+              child: Text(m >= 60 && m % 60 == 0 ? '${m ~/ 60} 小时' : '$m 分钟'),
+            ),
+        ],
+      ),
+    );
+    if (minutes == null) return;
+    await c.addEntry({'kind': '${kind['value']}', 'minutes': minutes});
+  }
+}
+
+/// 任务选择对话框（带搜索）。
+class _TaskPickerDialog extends StatefulWidget {
+  const _TaskPickerDialog({required this.controller});
+
+  final TaskListController controller;
+
+  @override
+  State<_TaskPickerDialog> createState() => _TaskPickerDialogState();
+}
+
+class _TaskPickerDialogState extends State<_TaskPickerDialog> {
+  String _q = '';
+
+  @override
+  Widget build(BuildContext context) {
+    final all = widget.controller._allTasks;
+    final list = _q.isEmpty
+        ? all
+        : all
+            .where((t) =>
+                '${t['name_zh']}'.contains(_q) ||
+                '${t['command']}'.toLowerCase().contains(_q.toLowerCase()))
+            .toList();
+    return AlertDialog(
+      title: const Text('选择任务'),
+      content: SizedBox(
+        width: 420,
+        height: 420,
+        child: Column(
+          children: [
+            TextField(
+              autofocus: true,
+              decoration: const InputDecoration(
+                isDense: true,
+                prefixIcon: Icon(Icons.search, size: 18),
+                hintText: '搜索…',
+                border: OutlineInputBorder(),
+              ),
+              onChanged: (v) => setState(() => _q = v.trim()),
+            ),
+            const SizedBox(height: 8),
+            Expanded(
+              child: ListView.builder(
+                itemCount: list.length,
+                itemBuilder: (_, i) {
+                  final t = list[i];
+                  return ListTile(
+                    dense: true,
+                    title: Text('${t['name_zh']}'),
+                    subtitle: Text(
+                        '${t['category_label']} · ${t['command']}'),
+                    onTap: () =>
+                        Navigator.pop(context, '${t['command']}'),
+                  );
+                },
+              ),
+            ),
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(
+            onPressed: () => Navigator.pop(context), child: const Text('取消')),
+      ],
+    );
+  }
+}
