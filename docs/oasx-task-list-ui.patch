+                          ? Theme.of(context).colorScheme.primary
+                          : Theme.of(context).disabledColor,
+                    )),
+          ),
+          _orderBtn(
+            icon: Icons.keyboard_arrow_up,
+            tip: inList ? '上移一位' : '加入执行顺序（追加到末尾）',
+            onTap: () async {
+              await _c.moveEntryUp(cmd);
+              await _c.reload();
+            },
+          ),
+          _orderBtn(
+            icon: Icons.keyboard_arrow_down,
+            tip: inList ? '下移一位' : '先加入执行顺序再下移',
+            enabled: inList && pos < _c.entries.length,
+            onTap: () async {
+              await _c.moveEntryDown(cmd);
+              await _c.reload();
+            },
+          ),
+        ],
+      ),
+    );
+  }
