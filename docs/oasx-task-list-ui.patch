+              children: [
+                OutlinedButton(
+                    onPressed: () => c.selectAll(),
+                    child: const Text('全选')),
+                OutlinedButton(
+                    onPressed: () => c.selectNone(),
+                    child: const Text('全不选')),
+                OutlinedButton(
+                    onPressed: () => c.selectInvert(),
+                    child: const Text('反选')),
+                OutlinedButton(
+                    onPressed: () => c.selectListOnly(),
+                    child: const Text('只选列表里的')),
+                const SizedBox(width: 8),
+                FilledButton(
+                  onPressed: c.selected.isEmpty || c.busy
+                      ? null
+                      : () => c.bulkApply(true),
+                  child: Text('启用选中 (${c.selected.length})'),
