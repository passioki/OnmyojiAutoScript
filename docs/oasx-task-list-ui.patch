+  /// * `↓`   = 下移一位; 未编排时禁用（用"下移"来加入语义反了）
+  Widget _orderCell(BuildContext context) {
+    final cmd = '${task['command'] ?? ''}';
+    final pos = _c.entryPositionOf(cmd);
+    final total = _c.entries.length;
