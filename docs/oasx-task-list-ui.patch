+      Get.put(TaskListController(scriptName: scriptName),
+          tag: tag, permanent: false);
+    }
+    final c = Get.find<TaskListController>(tag: tag);
+    return GetBuilder<TaskListController>(
+      tag: tag,
+      builder: (_) => DefaultTabController(
+        length: 2,
+        child: Column(
+          children: [
+            RunControlBar(controller: c),
+            _header(context, c),
+            const TabBar(
+              tabs: [
+                Tab(text: '任务总览'),
+                Tab(text: '任务列表（调度器）'),
