+          const SizedBox(width: 4),
+          Text('可跑 ${c.runnableCount} / ${c.tasks.length}',
+              style: Theme.of(context).textTheme.labelLarge),
+          if (c.loading)
+            const Padding(
+              padding: EdgeInsets.only(left: 12),
+              child: SizedBox(
+                width: 14, height: 14,
