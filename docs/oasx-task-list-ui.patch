+    return SizedBox(
+      width: 56,
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Tooltip(
+            message: inList
+                ? '执行顺序第 $pos 位（共 $total 个条目）'
+                : '未编排 —— 调度器用内置默认顺序',
+            child: Text(inList ? '$pos' : '—',
