+        child: Padding(
+          padding: EdgeInsets.all(24),
+          child: Center(child: Text('没有符合条件的任务')),
+        ),
+      );
+    }
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            _panelTitle(context, '任务总览',
+                '目标次数在「任务列表」里改 · 空白 = 用任务默认值'),
+            const SizedBox(height: 8),
+            _tableHeader(context),
+            const Divider(height: 1),
+            for (final t in c.tasks)
+              TaskRowView(task: t, mode: TaskRowMode.overview, controller: c),
+          ],
+        ),
+      ),
+    );
+  }
+
+  /// 表头 —— 与原型的 8 列对应。
+  Widget _tableHeader(BuildContext context) {
+    final s = Theme.of(context).textTheme.labelMedium;
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
+      child: Row(
+        children: [
+          const SizedBox(width: 28),
+          Expanded(flex: 22, child: Text('任务', style: s)),
+          Expanded(flex: 12, child: Text('类型', style: s)),
+          Expanded(flex: 14, child: Text('状态', style: s)),
+          Expanded(flex: 12, child: Text('目标次数', style: s)),
+          Expanded(flex: 12, child: Text('进度 / 存量', style: s)),
+          Expanded(flex: 16, child: Text('下次运行', style: s)),
+          Expanded(flex: 12, child: Text('对方', style: s)),
+          Expanded(flex: 12, child: Text('在列表', style: s)),
+        ],
+      ),
+    );
+  }
+}
+
+// ============================================================ tab 2: 任务列表
+
+/// 列表页 —— **唯一调度控制台**。
+class _ListTab extends StatelessWidget {
+  const _ListTab({required this.c});
+
+  final TaskListController c;
+
+  @override
+  Widget build(BuildContext context) {
+    return ListView(
+      padding: const EdgeInsets.all(12),
+      children: [
+        _globalPanel(context),
+        const SizedBox(height: 12),
+        RunListPanel(c: c),
+        const SizedBox(height: 12),
+        _flowPanel(context),
+      ],
+    );
+  }
+
+  /// 全局设置 —— 循环模式 + 优先级依据。
+  Widget _globalPanel(BuildContext context) {
+    final modes = c.modes;
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            _panelTitle(context, '全局设置', null),
+            const SizedBox(height: 8),
+            Wrap(
+              spacing: 16,
+              runSpacing: 8,
+              crossAxisAlignment: WrapCrossAlignment.center,
+              children: [
+                FilterChip(
+                  label: const Text('跑完循环整表'),
+                  selected: c.loopWholeList,
+                  onSelected: (_) => c.setLoopWholeList(!c.loopWholeList),
+                ),
+                Row(
+                  mainAxisSize: MainAxisSize.min,
+                  children: [
+                    const Text('优先级依据'),
+                    const SizedBox(width: 8),
+                    DropdownButton<String>(
+                      value: c.scheduleRule,
+                      isDense: true,
+                      items: [
+                        for (final m in modes)
+                          DropdownMenuItem<String>(
+                            value: '${m['value']}',
+                            child: Text('${m['label']}'),
+                          ),
+                      ],
+                      onChanged: (v) {
+                        if (v != null) c.setScheduleRule(v);
+                      },
+                    ),
+                  ],
+                ),
+                if (c.scheduleRule != c.listModeValue)
+                  Chip(
+                    label: Text('⚠ 顺序要生效需选「${c.listModeLabel}」'),
+                    visualDensity: VisualDensity.compact,
+                  ),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  /// 预期执行流程 —— **推算**, 不是保证。
+  Widget _flowPanel(BuildContext context) {
+    final flow = c.flow;
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            _panelTitle(context, '预期执行流程', '按当前列表推算'),
+            const SizedBox(height: 8),
+            if (flow.isEmpty)
+              const Text('（列表为空 —— 请先在上方添加条目）')
+            else ...[
+              for (final f in flow)
+                Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 2),
+                  child: Row(
+                    children: [
+                      SizedBox(
+                        width: 130,
+                        child: Text('${f['at']}',
+                            style: Theme.of(context).textTheme.labelSmall),
+                      ),
+                      SizedBox(
+                        width: 80,
+                        child: Text('${f['kind']}',
+                            style: Theme.of(context).textTheme.labelSmall),
+                      ),
+                      Expanded(child: Text('${f['text']}')),
+                      if ('${f['note']}'.isNotEmpty)
+                        Text('${f['note']}',
+                            style: Theme.of(context).textTheme.labelSmall),
+                    ],
+                  ),
+                ),
+              const SizedBox(height: 8),
+              Text(
+                '★ ${c.flowDisclaimer}',
+                style: Theme.of(context).textTheme.labelSmall,
+              ),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+// ============================================================ 共用
+
+Widget _panelTitle(BuildContext context, String title, String? hint) {
+  return Row(
+    crossAxisAlignment: CrossAxisAlignment.baseline,
+    textBaseline: TextBaseline.alphabetic,
+    children: [
+      Text(title, style: Theme.of(context).textTheme.titleSmall),
+      if (hint != null) ...[
+        const SizedBox(width: 8),
+        Flexible(
+          child: Text(hint, style: Theme.of(context).textTheme.labelSmall),
+        ),
+      ],
+    ],
+  );
+}
