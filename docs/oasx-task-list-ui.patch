+  }
+
+  Widget _bulkPanel(BuildContext context) {
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(12),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            _panelTitle(context, '批量操作',
+                '改的是 scheduler.enable（任务级长期开关）'),
