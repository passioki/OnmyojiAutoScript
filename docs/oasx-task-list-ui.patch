+            Expanded(
+              child: TabBarView(
+                children: [
+                  _OverviewTab(c: c),
+                  _ListTab(c: c),
+                ],
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  /// 顶部:刷新 / 运行控制概览。
+  Widget _header(BuildContext context, TaskListController c) {
+    final r = c.overview;
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 4),
